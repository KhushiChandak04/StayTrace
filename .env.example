# Optional Qualcomm GenieX settings for Snapdragon deployment.
# The current GenieX Python SDK supports from_pretrained() with a local path,
# Hugging Face model, or AI Hub model reference. Keep model identifiers here
# configurable so the application does not hard-code an environment-specific path.
STAYTRACE_AI_BACKEND=auto
STAYTRACE_GENIEX_MODEL=ai-hub-models/Qwen3-VL-4B-Instruct
STAYTRACE_GENIEX_DEVICE_MAP=qairt
STAYTRACE_DATA_DIR=storage
